{
  "name": "cv",
  "version": "2026.8.0",
  "description": "",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "prepare": "lefthook install",
    "clean": "rm -rf node_modules dist",
    "build": "tsc && tsc-alias",
    "render": "run-s build render:exec",
    "render:exec": "node dist/main.js",
    "watch:render": "nodemon --watch src -e ts,tsx,css,mdx --exec \"npm run render\"",
    "serve": "web-dev-server --root-dir dist --open cv.html --watch",
    "dev": "run-p watch:render serve",
    "pdf": "run-s render print:exec",
    "print:exec": "node dist/print.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "lint": "run-s --continue-on-error lint:eslint lint:stylelint",
    "lint:fix:eslint": "eslint . --fix",
    "lint:fix:stylelint": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "run-s --continue-on-error lint:fix:eslint lint:fix:stylelint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "qualitycheck": "run-s --continue-on-error format:check lint typecheck build knip"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@web/dev-server": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "private": true
}
