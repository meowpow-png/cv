{
  "extends": "stylelint-config-standard",
  "ignoreFiles": ["dist/**", "node_modules/**"],
  "overrides": [
    {
      "files": ["**/*.module.css"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          {
            "message": "Expected class selector \"%s\" to be camelCase"
          }
        ]
      }
    }
  ]
}
